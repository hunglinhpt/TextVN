<!-- <name> PHẢI trùng tên bus mà textvn-ibus-engine xin (TEXTVN_IBUS_COMPONENT trong
     adapters/linux-ibus/src/main.c): ibus-daemon chờ đúng tên này khi khởi chạy <exec>. -->
<component>
  <name>io.github.hunglinhpt.textvn</name>
  <description>TextVN Vietnamese Input Method</description>
  <version>0.2.14</version>
  <license>GPL-3.0-or-later</license>
  <author>LinhBH.CoM &lt;https://github.com/hunglinhpt/TextVN&gt;</author>
  <homepage>https://github.com/hunglinhpt/TextVN</homepage>
  <exec>/usr/lib/textvn/textvn-ibus-engine --ibus</exec>
  <textdomain>textvn</textdomain>
  <engines>
    <engine>
      <name>textvn</name>
      <longname>Vietnamese (TextVN)</longname>
      <description>Vietnamese Input Method (Telex, VNI, VIQR)</description>
      <language>vi</language>
      <license>GPL-3.0-or-later</license>
      <author>LinhBH.CoM</author>
      <icon>textvn_v</icon>
      <layout>default</layout>
      <symbol>VN</symbol>
      <setup>/usr/bin/textvn-settings</setup>
      <rank>99</rank>
    </engine>
  </engines>
</component>
