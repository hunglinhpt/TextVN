#define IDI_ICON_V 1
#define IDI_ICON_E 2
#define IDI_ICON_T 3

1 ICON "resources/textvn_v.ico"
2 ICON "resources/textvn_e.ico"
3 ICON "resources/textvn.ico"

1 24 "tray.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hunglinhpt"
            VALUE "FileDescription", "TextVN - Bo go Tieng Viet Chuyen Nghiep"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "TextVN"
            VALUE "LegalCopyright", "Copyright (C) 2026 hunglinhpt. Open Source under GPL-3.0-or-later"
            VALUE "OriginalFilename", "TextVN.exe"
            VALUE "ProductName", "TextVN"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
