{
  "targets_version": 1,
  "app_id": "notes",
  "match": { "any": [ { "bundle_id": "com.apple.Notes" } ] },
  "launch": {
    "kind": "app",
    "paths": [ "/System/Applications/Notes.app" ],
    "args": [],
