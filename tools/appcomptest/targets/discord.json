{
  "targets_version": 1,
  "app_id": "discord",
  "match": { "any": [ { "exe": "discord.exe" } ] },
  "launch": {
    "kind": "exe",
    "paths": [ "%LOCALAPPDATA%\\Discord\\Discord.exe" ],
    "args": [],
    "ready_class": "Chrome_WidgetWin_1"
  },
  "fields": [
    {
      "field_role": "body",
      "preset": "win.discord",
      "locators": [
        { "control_type": "Edit", "name_regex": "(?i)message" },
        { "control_type": "Edit", "class_name": "Chrome_RenderWidgetHostHWND" },
        { "control_type": "Document" }
      ],
      "notes": "B2 Enter lap, B7 Electron a11y. UNTESTED locally (app chua cai)."
    }
  ]
}
