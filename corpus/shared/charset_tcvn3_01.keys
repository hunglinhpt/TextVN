# corpus/shared/charset_tcvn3_01.keys — bảng mã xuất tcvn3 (bảng: data/tables/charsets.tsv từ UniKey)
# Backspace xoá ký tự cuối đang hiển thị (R2-55, UniKey processBackspace): `được` → `đượ`.
:config method=telex diacritic_style=new output_charset=tcvn3 auto_capitalize=false
:type "dduocj"
:expect "®­îc"
:key Backspace
:expect "®­î"
:key Space
:type "Vieetj Nam"
:expect "®­î ViÖt Nam"
:key Space
:type "tieengs"
:key Escape
:expect "®­î ViÖt Nam tieengs"
