# corpus/shared/charset_unicode_decomposed_01.keys — bảng mã xuất unicode_decomposed (bảng: data/tables/charsets.tsv từ UniKey)
# Backspace xoá ký tự cuối đang hiển thị (R2-55, UniKey processBackspace): `được` → `đượ`.
:config method=telex diacritic_style=new output_charset=unicode_decomposed auto_capitalize=false
:type "dduocj"
:expect "được"
:key Backspace
:expect "đượ"
:key Space
:type "Vieetj Nam"
:expect "đượ Việt Nam"
:key Space
:type "tieengs"
:key Escape
:expect "đượ Việt Nam tieengs"
