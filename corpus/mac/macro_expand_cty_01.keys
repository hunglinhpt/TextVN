# corpus/mac/macro_expand_cty_01 — macro mở rộng khi Space (macro_trigger=space) (P2-5 §2)
:config method=telex diacritic_style=new
:app com.apple.textedit field=body

:config method=telex diacritic_style=new macro_trigger=space macro="cty=Công ty TNHH"
:type "cty"
:expect "cty"
:expect_action REPLACE
:key Space
:expect "Công ty TNHH"
