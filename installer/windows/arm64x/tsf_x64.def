; ARM-W2: ARM64EC (x64 emulated process) export forwarders for textvn-tsf.dll (ARM64X pure forwarder).
; Matches adapters/windows-tsf/src/lib.rs COM exports (registration uses textvn-cli).
EXPORTS
    DllGetClassObject=textvn-tsf-x64.DllGetClassObject
    DllCanUnloadNow=textvn-tsf-x64.DllCanUnloadNow
