{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietime.dev/schemas/appdb.v1.schema.json",
  "title": "VietIME application preset database v1",
  "$comment": "VietIME appdb v1. SPDX header cua file nay nam trong REUSE.toml (khong dat trong JSON — reuse lint se doc nham).",
  "type": "object",
  "required": ["appdb_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "appdb_version": { "const": 1 },
    "min_engine_version": { "$ref": "#/$defs/semver" },
    "updated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "appIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "matchClause": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "exe": { "$ref": "#/$defs/appIdentifier" },
        "bundle": { "$ref": "#/$defs/appIdentifier" },
        "class": { "$ref": "#/$defs/appIdentifier" },
        "and_subprocess": { "type": "boolean" }
      }
    },
    "matcher": {
      "oneOf": [
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/matchClause" }
            }
          }
        },
        { "$ref": "#/$defs/matchClause" }
      ]
    },
    "fieldRole": {
      "enum": [
        "unknown", "body", "editbox", "address_bar", "search", "combo",
        "candidate", "textarea", "web", "terminal", "secure"
      ]
    },
    "entry": {
      "type": "object",
      "required": ["match"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "match": { "$ref": "#/$defs/matcher" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field_role": {
              "oneOf": [
                { "$ref": "#/$defs/fieldRole" },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/fieldRole" }
                }
              ]
            }
          }
        },
        "strategy": {
          "enum": [
            "Preedit", "BackspaceType", "SelectionReplace", "ForwardAsCommit", "Passthrough"
          ]
        },
        "inject_mode": {
          "enum": ["unicode", "vk_then_unicode", "selection", "keycode_ascii"]
        },
        "engine_owner": {
          "enum": ["tsf", "hook", "imk", "tap", "ibus", "fcitx5", "x11"]
        },
        "enabled_default": { "type": "boolean" },
        "min_engine_version": { "$ref": "#/$defs/semver" },
        "min_os": { "type": ["string", "null"] },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    }
  }
}
