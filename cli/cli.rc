1 ICON "../tray/resources/vietime_v.ico"
1 24 "cli.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TextVN Project - LBS Viet Nam"
            VALUE "FileDescription", "TextVN Command Line Utility (LBS Viet Nam)"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "textvn-cli"
            VALUE "LegalCopyright", "Copyright (C) 2026 TextVN Contributors. Open Source under GPL-3.0-or-later"
            VALUE "OriginalFilename", "textvn-cli.exe"
            VALUE "ProductName", "TextVN (LBS Viet Nam)"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
